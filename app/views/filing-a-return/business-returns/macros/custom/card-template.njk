{% macro card(cardStyle, cardLinkClass, cardUrl, headingLevel="h2", heading, headingSize, statusClass, statusMessage, details, linkContent, links, cardId) %}
<div class="pta-card {{ cardStyle }}" {% if cardId %}id="{{cardId}}"{% endif %}>

    <div class="pta-card-body {{ cardLinkClass }} {% if cardUrl %}active{% endif %}">
        {% if cardUrl %}
          <{{headingLevel}} class="govuk-heading-{{ headingSize or "s" }} pta-card-heading"><a href="{{cardUrl}}">{{ heading }}</a></{{headingLevel}}>
        {% else %}
          <{{headingLevel}} class="govuk-heading-{{ headingSize or "s" }} pta-card-heading">{{ heading }}</{{headingLevel}}>
        {% endif %}

        {% if statusClass %} <div class="status {{ statusClass }}"> {{ statusMessage }}</div>  {% endif %}

        {% if details %}
            {% for content in details %}
                <div class="{{ content.class }}">{{ content.content | safe }}</div>
            {% endfor %}
        {% endif %}
        {% if linkContent %}
            <p>{{ linkContent }}</p>
        {% endif %}
    </div>

    {% if links %}
        <div class="pta-card-action">
        <ul class="govuk-list" >
            {% for link in links %}
                <li><a href= {{ link.url }}>{{ link.title }}</a></li>
            {% endfor %}
        </ul>
        </div>
    {% endif %}
</div>
{% endmacro %}